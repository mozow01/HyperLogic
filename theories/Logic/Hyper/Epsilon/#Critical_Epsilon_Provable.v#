Require Import HyperLogic.Logic.Base.Epsilon.Base_Syntax.
Require Import HyperLogic.Logic.Hyper.Epsilon.Hyper_Syntax.

Require Import List.
Import ListNotations.

(* ================================================================= *)
(* A GENERIKUS DUÁLIS DRINKER PARADOXON (Minden formulára)           *)
(* ================================================================= *)

(* A formula: \exists x. ( (\exists y. Phi(y)) -> Phi(x) )
   Itt a Phi BÁRMILYEN formula lehet, ami az I x D kontextusban értelmezett! *)
Definition Dual_Drinker_Generic {Sign : Type} (I D : b_ty) (Phi : @h_ty Sign) : @h_ty Sign :=
  Ty_Ex D ( 
    (* KIKÉNYSZERÍTJÜK, hogy a hiperdoktrína (h_ty) nyílját használja a Coq, 
       és ne az STLC-s propozicionális nyilat! *)
    (Ty_Arrow : @h_ty Sign -> @h_ty Sign -> @h_ty Sign) 
    (form_pullback b_fst (Ty_Ex D Phi)) 
    Phi 
  ).

(* A FŐTÉTEL: Bármely I, D bázis felett és BÁRMELY Phi formulára igaz! *)
Lemma dual_drinker_general {Sign : Type} `{SkolemMapping Sign} 
  (I D : b_ty) (Phi : @h_ty Sign) : 
  exists (p : @h_tm Sign), h_typing I [] p (Dual_Drinker_Generic I D Phi).
Proof.
  unfold Dual_Drinker_Generic.
  
  (* LÉPÉS 0: Beteszünk egy lyukat (?p) a bizonyításterm helyére, 
     amit a Coq a szabályok (eapply) alapján automatikusan felépít nekünk! *)
  eexists.

  (* LÉPÉS 1: A Skolem-tanú legenerálása a tetszőleges Phi formulából. *)
  pose (Sko := b_const D (skolem_index D Phi)).

  (* Konverzió az Arrow visszahúzásának lekezelésére *)
  eapply HT_Conv.
  2: { admit. (* Itt a base_equiv / form_equiv majd igazolja az egyenlőséget *) }
  
  (* Egzisztenciális bevezetés a Skolem-tanúval *)
  eapply HT_Ex_Intro with (f := Sko).
  - apply BT_Const. 
  
  (* Implikáció bevezetése *)
  - apply HT_Lam.
    
    (* Egzisztenciális elimináció a feltételen (\exists y. Phi(y)) *)
    eapply HT_Ex_Elim.
    + apply HT_Var0. 
    
    + (* Konverzió alkalmazása a Phi(y) -> Phi(Sko) cseréhez *)
      eapply HT_Conv.
      2: { admit. (* A form_equiv igazolja, hogy matematikailag egyenlőek *) }
      
      (* Az Epszilon Szabály alkalmazása a hipotetikus tanúval (b_snd) *)
      eapply HT_Eps_Intro with (f := b_snd).
      * apply BT_Snd.
      * apply HT_Var0.
Admitted.